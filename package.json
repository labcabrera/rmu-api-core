{
  "name": "rmu-api-core",
  "version": "0.4.3",
  "main": "dist/app.js",
  "description": "Core API for RMU",
  "scripts": {
    "build": "npm run clean && tsc",
    "start": "node dist/app.js",
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/app.ts",
    "dev:watch": "nodemon --ext ts --exec \"ts-node -r tsconfig-paths/register src/app.ts\"",
    "test": "jest --config jest.config.js",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [],
  "author": {
    "name": "Luis Cabrera",
    "email": "lab.cabrera@gmail.com"
  },
  "license": "GPL-3.0",
  "dependencies": {
    "@rsql/parser": "^1.6.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "inversify": "^7.7.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.2.0",
    "kafkajs": "^2.2.4",
    "module-alias": "^2.2.3",
    "mongoose": "^8.17.0",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.7.1",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/kafkajs": "^1.8.2",
    "@types/node": "^24.1.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "jest": "^30.0.5",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2"
  },
  "_moduleAliases": {
    "@domain": "dist/domain",
    "@infrastructure": "dist/infrastructure",
    "@application": "dist/application",
    "@adapters": "dist/adapters",
    "@shared": "dist/shared"
  }
}
