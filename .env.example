# rmu-api-core: local development outside Docker (`pnpm start:dev`). Copy to .env.
# Requires the infrastructure started from rmu-platform (`make up-infra`). From the host:
# Mongo localhost:27017, Keycloak http://localhost:8090/sso, Kafka localhost:9093. Port 9092 is the
# in-network listener and advertises rmu-kafka-broker, which the host cannot resolve.

# --- Server ---------------------------------------------------------------------------------------
PORT=3001
LOG_LEVEL=debug

# --- MongoDB --------------------------------------------------------------------------------------
RMU_MONGO_CORE_URI=mongodb://admin:admin@localhost:27017/rmu-core?authSource=admin

# --- Keycloak -------------------------------------------------------------------------------------
# RMU_IAM_URI and RMU_IAM_REALM are optional: they only build the OAuth URLs of the Swagger UI.
RMU_IAM_URI=http://localhost/sso
RMU_IAM_REALM=rmu
RMU_IAM_JWK_URI=http://localhost:8090/sso/realms/rmu/protocol/openid-connect/certs
RMU_IAM_ISSUER_URI=http://localhost/sso/realms/rmu
RMU_IAM_AUDIENCE=rmu-api

# Service account (client credentials): the API calls users with it (spec 069), and scripts/smoke.sh uses it too.
RMU_IAM_TOKEN_URI=http://localhost:8090/sso/realms/rmu/protocol/openid-connect/token
RMU_IAM_CLIENT_ID=rmu-client
RMU_IAM_CLIENT_SECRET=changeit

# --- Other APIs -----------------------------------------------------------------------------------
# users: friendships, to share realms only with friends (spec 069).
RMU_API_USERS_URI=http://localhost:3010/v1
# RMU_HTTP_TIMEOUT_MS=10000

# --- Kafka ----------------------------------------------------------------------------------------
RMU_KAFKA_BROKERS=localhost:9093
RMU_KAFKA_CLIENT_ID=rmu-api-core
RMU_KAFKA_CONSUMER_GROUP_ID=rmu-api-core-consumer
RMU_KAFKA_DEFAULT_PARTITIONS=1

# --- HTTP (optional) --------------------------------------------------------------------------------
# No origins: CORS stays off. RMU_THROTTLE_LIMIT=0 turns the request limit off.
RMU_CORS_ORIGINS=
RMU_THROTTLE_LIMIT=300
RMU_THROTTLE_TTL_MS=60000
RMU_TRUST_PROXY=loopback, linklocal, uniquelocal
