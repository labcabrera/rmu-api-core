@startuml c4-context
title Context RMU Engine API Core Context Diagram

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_LEFT_RIGHT()

UpdateElementStyle(person, $bgColor="#2b4a74ff")
UpdateElementStyle(system, $bgColor="#4373b1ff")
UpdateElementStyle(external_system, $bgColor="#96b6beff")
UpdateElementStyle(boundary, $bgColor="#d1dcdfff")

Person(user, "User")

Boundary(frontend, "RMU Engine Frontend") {
    System_Ext(rmu_fe_host, "MFE Shell", "React")
    System_Ext(rmu_fe_strategic, "MFE Strategic", "React")
    System_Ext(rmu_fe_tactical, "MFE Tactical", "React")
}

Boundary(apis, "RMU APIs") {
    System(rmu_api_core, "Core API", "NestJS")
}

Boundary(infrastructure, "Infrastructure") {
    System_Ext(mongodb, "MongoDB", "")
    System_Ext(keycloak, "Keycloak", "26.3")
    System_Ext(kafka, "Kafka", "")
}

Rel(user, rmu_fe_host, "Navigate", "HTTP")
Rel(user, keycloak, "Login", "HTTP")

Rel(rmu_fe_host, rmu_fe_strategic, "Federation", "Webpack")
Rel(rmu_fe_host, rmu_fe_tactical, "Federation", "Webpack")
Rel(rmu_fe_host, keycloak, "Authenticate user", "OIDC")

Rel(rmu_fe_strategic, rmu_api_core, "Fetch data", "HTTP / JWT")
Rel(rmu_fe_tactical, rmu_api_core, "Fetch data", "HTTP / JWT")

Rel(rmu_api_core, mongodb, "R/W", "Mongoose")
Rel(rmu_api_core, keycloak, "Read JWK", "HTTP")
BiRel(rmu_api_core, kafka, "R/W", "")

SHOW_LEGEND()

@enduml
